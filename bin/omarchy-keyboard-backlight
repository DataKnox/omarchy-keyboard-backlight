#!/bin/bash

# Mirror macOS keyboard backlight behaviour on Apple Silicon MacBooks:
#   - only light the keys when the room is dark (ambient light sensor)
#   - turn them off after a short idle, back on at the first key or touch
#   - a manual brightness change becomes the new preferred level
#
# The Omarchy shell plugin (Service.qml) calls `tick` every couple of seconds
# and `idle` / `active` from the compositor's idle notifier.
#
# Usage:
#   omarchy-keyboard-backlight probe    # exit 0 when the sensor and LED exist
#   omarchy-keyboard-backlight tick     # one ambient-light pass
#   omarchy-keyboard-backlight idle     # keys off (idle notifier timeout)
#   omarchy-keyboard-backlight active   # keys back on (idle notifier resume)
#   omarchy-keyboard-backlight daemon   # run ticks in a loop (no shell plugin)
#   omarchy-keyboard-backlight status   # print sensor + state

CONFIG="$HOME/.config/omarchy/keyboard-backlight.conf"
STATE_DIR="$HOME/.local/state/omarchy/keyboard-backlight"
LED=/sys/class/leds/kbd_backlight
ALS=$(ls -d /sys/bus/iio/devices/iio:device*/ 2>/dev/null | while read -r d; do [[ $(cat "$d/name") == *als* ]] && echo "${d}in_illuminance_input" && break; done)

# Defaults; override in $CONFIG.
DARK_LUX=40        # below this, the room counts as dark -> keys on
BRIGHT_LUX=80      # above this, the room counts as bright -> keys off (hysteresis)
DEFAULT_LEVEL=100  # 0-255, used until you set a level with the brightness keys
POLL_SECONDS=2
[[ -f $CONFIG ]] && source "$CONFIG"

supported() { [[ -n $ALS && -r $ALS && -f $LED/brightness ]]; }

if [[ ${1:-} == "probe" ]]; then
  supported && exit 0
  echo "no ambient light sensor or keyboard backlight found" >&2
  exit 1
fi
supported || exit 0

mkdir -p "$STATE_DIR"
max=$(cat "$LED/max_brightness")

read_state() {
  preferred=$(cat "$STATE_DIR/preferred" 2>/dev/null || echo "$DEFAULT_LEVEL")
  last_written=$(cat "$STATE_DIR/last-written" 2>/dev/null || echo -1)
  dark=$(cat "$STATE_DIR/dark" 2>/dev/null || echo 1)
  idle=$(cat "$STATE_DIR/idle" 2>/dev/null || echo 0)
}

write_level() {
  local level=$1
  (( level < 0 )) && level=0
  (( level > max )) && level=$max
  if (( $(cat "$LED/brightness") != level )); then
    brightnessctl -q -d kbd_backlight set "$level"
  fi
  echo "$level" > "$STATE_DIR/last-written"
}

# A brightness that differs from what we last wrote was set by the user
# (keyboard keys, Touch Bar, omarchy brightness keyboard). Adopt it.
adopt_manual_change() {
  local current
  current=$(cat "$LED/brightness")
  if (( last_written >= 0 && current != last_written )); then
    echo "$current" > "$STATE_DIR/preferred"
    preferred=$current
    echo "$current" > "$STATE_DIR/last-written"
    last_written=$current
  fi
}

apply() {
  if (( dark && ! idle )); then
    write_level "$preferred"
  else
    write_level 0
  fi
}

update_dark() {
  local lux
  lux=$(cat "$ALS" 2>/dev/null) || return
  if (( dark && lux > BRIGHT_LUX )); then
    dark=0
  elif (( ! dark && lux < DARK_LUX )); then
    dark=1
  fi
  echo "$dark" > "$STATE_DIR/dark"
}

tick() {
  read_state
  adopt_manual_change
  update_dark
  apply
}

case ${1:-} in
  tick)
    tick
    ;;
  daemon)
    while true; do
      tick
      sleep "$POLL_SECONDS"
    done
    ;;
  idle)
    read_state
    adopt_manual_change
    echo 1 > "$STATE_DIR/idle"; idle=1
    apply
    ;;
  active)
    read_state
    echo 0 > "$STATE_DIR/idle"; idle=0
    apply
    ;;
  status)
    read_state
    echo "lux=$(cat "$ALS" 2>/dev/null) dark=$dark idle=$idle preferred=$preferred brightness=$(cat "$LED/brightness")/$max"
    echo "thresholds: dark<$DARK_LUX bright>$BRIGHT_LUX (edit $CONFIG)"
    ;;
  *)
    sed -n '/^# Usage:/,/^$/p' "$0" >&2
    exit 1
    ;;
esac
